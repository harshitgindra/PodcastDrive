# PodcastDrive — Configuration
#
# GENERATED FILE — do not edit by hand.
# Regenerate with:  make config-example   (or python -m settings --write)
# Every knob is declared in src/settings.py; that is the file to change.
#
# Copy this file to config.env and fill in your values.
# Do NOT commit config.env to version control.
#
# Lines are commented out where the built-in default is already the right
# answer. Uncomment and edit only what you need to change.

# --- AWS ---

# AWS region for S3, Transcribe and Bedrock. Must match the bucket's region.
AWS_DEFAULT_REGION=us-west-2

# Seconds to wait for a TCP connection to an AWS endpoint before retrying. botocore's own
# default is 60s, long enough for one blackholed SYN to stall a run.
# AWS_CONNECT_TIMEOUT=10.0

# Seconds to wait for an AWS response body. Do not lower: Bedrock ad detection and Transcribe
# polling legitimately run close to this ceiling.
# AWS_READ_TIMEOUT=60.0

# Static AWS key. Prefer SSO or ~/.aws profiles.
# AWS_ACCESS_KEY_ID=

# Static AWS secret. Prefer SSO or ~/.aws profiles.
# AWS_SECRET_ACCESS_KEY=

# --- Storage / CDN ---

# S3 bucket holding audio, manifests, feeds and run history.
S3_BUCKET=

# Public CloudFront base URL, e.g. https://d123.cloudfront.net.
CLOUDFRONT_BASE=

# CloudFront distribution to invalidate after a feed changes.
CLOUDFRONT_DISTRIBUTION_ID=

# --- Config provider ---

# Where podcast definitions come from: "yaml" or "notion".
CONFIG_PROVIDER=yaml

# Path to the YAML config when CONFIG_PROVIDER=yaml.
# PODCASTS_YAML=podcasts.yaml

# Notion integration token when CONFIG_PROVIDER=notion.
# NOTION_API_KEY=

# Notion database id when CONFIG_PROVIDER=notion.
# NOTION_DATABASE_ID=

# --- YouTube pipeline ---

# Cap on new YouTube episodes downloaded per playlist per run.
# MAX_DOWNLOADS_PER_RUN=10

# Ignore episodes older than this many days. 0 means no age limit. The RSS pipeline defaults to
# 0 (no limit) when this is unset.
# MAX_AGE_DAYS=7

# Seconds to pause between YouTube downloads, to look less like a bot.
# SLEEP_BETWEEN_DOWNLOADS=5

# MP3 encoding bitrate in kbps.
# MP3_QUALITY=192

# Attempts per download before giving up (transient failures only).
# DOWNLOAD_MAX_RETRIES=3

# Minimum back-off seconds between download attempts.
# DOWNLOAD_RETRY_WAIT_MIN=5

# Maximum back-off seconds between download attempts.
# DOWNLOAD_RETRY_WAIT_MAX=60

# Netscape cookies file giving yt-dlp a logged-in YouTube session.
# COOKIES_FILE=cookies.txt

# Explicit cookies-file path, overriding the search of COOKIES_FILE and the repo/home default
# locations.
# YTDLP_COOKIES=

# Comma-separated yt-dlp remote components. The JavaScript n-challenge solver ships as an opt-in
# remote component; without it yt-dlp returns storyboard images only and every download fails
# with "Requested format is not available". Set to an empty string only if the solver cache is
# pre-seeded.
# YTDLP_REMOTE_COMPONENTS=ejs:github

# Orphan count below which S3 reconciliation deletes nothing.
# RECONCILE_MIN_ORPHANS=3

# Refuse to reconcile when orphans exceed this fraction of objects.
# RECONCILE_MAX_ORPHAN_RATIO=0.5

# --- RSS pipeline ---

# Cap on new RSS episodes downloaded per feed per run.
# PODCAST_MAX_EPISODES=5

# Episodes processed in parallel per feed (1 = sequential). 3 balances speed against AWS API
# rate limits; the work is IO-bound.
# PODCAST_EPISODE_WORKERS=1

# Lifetime splice attempts per episode before it is abandoned.
# MAX_SPLICE_RETRIES=3

# Splice retries attempted in any single run, across all episodes.
# SPLICE_MAX_ATTEMPTS_PER_RUN=2

# Refuse RSS feeds larger than this. The largest real feeds are ~5 MiB.
# MAX_FEED_BYTES=33554432

# Refuse iTunes lookup/search responses larger than this.
# MAX_ITUNES_BYTES=8388608

# --- Ad removal ---

# Master switch for Transcribe + Bedrock ad removal.
# REMOVE_ADS=true

# Detect and report ad segments without re-encoding the audio.
# REMOVE_ADS_DRY_RUN=false

# Also trim a music-only intro from the start of each episode.
# TRIM_MUSIC_INTRO=false

# Also trim a music-only outro from the end of each episode.
# TRIM_MUSIC_OUTRO=false

# Shortest music intro worth trimming, in seconds.
# MUSIC_INTRO_MIN_SECS=8.0

# Shortest music outro worth trimming, in seconds.
# MUSIC_OUTRO_MIN_SECS=5.0

# Move cut points to the nearest detected silence so splices are inaudible.
# AD_SNAP_TO_SILENCE=true

# Merge two ad segments separated by less than this gap.
# AD_MERGE_GAP_SECS=2.0

# Discard detected ad segments shorter than this.
# MIN_AD_SEGMENT_SECS=5.0

# Discard detected ad segments longer than this (likely a detection error).
# MAX_AD_SEGMENT_SECS=300.0

# Send segments longer than this to the second-pass verification model.
# AD_VERIFY_THRESHOLD_SECS=90.0

# Transcript characters per Bedrock detection request.
# AD_DETECT_MAX_CHARS=60000

# Overlap between consecutive detection chunks, so ads at a seam are seen.
# AD_DETECT_OVERLAP_SECS=60.0

# Comma-separated "start:end" second ranges to transcribe instead of the whole episode; "end"
# means total duration and "end-N" means total minus N. Example: 0:300,end-600:end.
# AD_TRANSCRIBE_WINDOWS=

# Apply EBU R128 loudness normalisation after splicing. Equalises loudness across kept intervals
# so cut points are inaudible; costs 10-20% more ffmpeg time.
# SPLICE_LOUDNORM=true

# BCP-47 language code for AWS Transcribe.
# TRANSCRIBE_LANGUAGE_CODE=en-US

# Seconds between Transcribe job status polls.
# TRANSCRIBE_POLL_INTERVAL=10

# Seconds to wait for a Transcribe job before giving up.
# TRANSCRIBE_MAX_WAIT=3600

# Reuse transcripts cached in S3 instead of paying to transcribe again.
# TRANSCRIBE_CACHE_ENABLED=true

# S3 key prefix for cached transcripts.
# TRANSCRIBE_CACHE_PREFIX=transcribe-cache

# Bedrock model for ad verification and episode summaries.
# BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Bedrock model for first-pass detection over every transcript chunk. Falls back to
# BEDROCK_MODEL_ID.
# BEDROCK_DETECT_MODEL_ID=

# Re-transcribe cleaned audio and report residual ads. Costs extra AWS spend.
# EVALUATE_AD_REMOVAL=false

# Directory for ad-removal evaluation reports.
# EVAL_REPORTS_DIR=reports

# Generate AI episode summaries via Bedrock (one extra call per episode).
# GENERATE_SUMMARIES=false

# Skip summaries for episodes longer than this many seconds. 0 disables the guard.
# SUMMARY_MAX_DURATION_SECS=1800

# --- ffmpeg / ffprobe timeouts ---

# Timeout for the ffmpeg silencedetect pass.
# FFMPEG_SILENCEDETECT_TIMEOUT_SECS=1800.0

# Timeout for the ffmpeg splice/concat pass.
# FFMPEG_SPLICE_TIMEOUT_SECS=3600.0

# Timeout for extracting a single audio segment.
# FFMPEG_SEGMENT_TIMEOUT_SECS=600.0

# Timeout for an ffprobe metadata probe.
# FFPROBE_TIMEOUT_SECS=60.0

# --- Feed presentation ---

# Suffix appended to the channel title in generated feeds, so managed feeds are visually
# distinct from the originals. Set to "" to disable.
# FEED_TITLE_SUFFIX= ✂️

# Secondary label shown under the title in Overcast and Apple Podcasts. Set to "" to disable.
# FEED_SUBTITLE=Ad-free · PodcastDrive

# Suffix added to episode titles whose ads were removed. Set to "" to disable.
# EPISODE_AD_REMOVED_SUFFIX= ✂️

# --- Logging ---

# Directory for rotating log files (local runs only; ignored on Lambda).
# LOG_DIR=./logs

# Logging level: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO

# Set to "json" for structured logs; anything else gives human-readable lines.
# LOG_FORMAT=

# Daily log files to keep before the oldest is deleted.
# LOG_RETENTION_DAYS=30

# --- Health alerting ---

# Webhook POSTed when the health report finds HIGH-priority issues (Slack, ntfy, PagerDuty,
# ...). Empty disables alerting.
# HEALTH_ALERT_URL=

# --- Run notifications (via Herald) ---
#
# Notifications are sent through Herald (https://github.com/harshitgindra/Herald).
# Install:   pipx install ~/Projects/Herald
# Configure: ~/.config/herald/config.yaml
# When Herald is not installed, notifications are silently skipped.
