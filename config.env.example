# YouTube Playlist to Podcast — Configuration
# Copy this file to config.env and fill in your values.
# Do NOT commit config.env to version control.

# --- AWS Credentials ---
# Prefer AWS SSO, IAM Identity Center, or ~/.aws/credentials profiles over
# long-lived access keys. Only set these if SSO/profiles are not an option.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2

# --- S3 Storage ---
S3_BUCKET=

# --- CloudFront CDN ---
CLOUDFRONT_BASE=
CLOUDFRONT_DISTRIBUTION_ID=

# --- Processing Defaults ---
MAX_DOWNLOADS_PER_RUN=10
MAX_AGE_DAYS=5
SLEEP_BETWEEN_DOWNLOADS=5

# --- Config Provider ---
# "yaml" (default) — reads from podcasts.yaml
# "notion" — reads from a Notion database
CONFIG_PROVIDER=yaml

# --- YAML Config (when CONFIG_PROVIDER=yaml) ---
# PODCASTS_YAML=podcasts.yaml

# --- Notion Config (when CONFIG_PROVIDER=notion) ---
# NOTION_API_KEY=secret_xxx
# NOTION_DATABASE_ID=xxx-xxx-xxx

# --- RSS Podcast Feeds (Source=Podcast in Notion) ---
# Maximum number of new episodes to download per podcast per run (default: 5)
# PODCAST_MAX_EPISODES=5
# Number of episodes to process in parallel per podcast feed (default: 1 = sequential).
# Set to 3 for a good balance of speed vs AWS API rate limits.
# Download + Transcribe + Bedrock are IO-bound, so workers spend most time waiting.
# PODCAST_EPISODE_WORKERS=1
# Set to "false" to disable EBU R128 loudness normalisation after audio splicing.
# Loudnorm equalises loudness across kept intervals — silence at cut points is inaudible.
# Adds ~10-20% to ffmpeg processing time. (default: true)
# SPLICE_LOUDNORM=true
# Comma-separated time-window ranges to transcribe instead of the full episode.
# Format: "start:end" in seconds; use "end" for total duration, "end-N" for total-N.
# Example: only transcribe first 5 min + last 10 min (saves Transcribe cost on long episodes):
# AD_TRANSCRIBE_WINDOWS=0:300,end-600:end

# --- Ad Removal (AWS Transcribe + Bedrock) ---
# Set to "false" to disable ad removal entirely (default: true)
# REMOVE_ADS=true
# BCP-47 language code for AWS Transcribe (default: en-US)
# TRANSCRIBE_LANGUAGE_CODE=en-US
# Bedrock model ID for second-pass ad-segment verification (accuracy matters — Sonnet recommended)
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# Bedrock model ID for first-pass detection across all transcript chunks.
# Defaults to BEDROCK_MODEL_ID when unset. Set to a cheaper model (e.g. Haiku)
# to cut per-episode detection cost by ~80% with minimal quality loss.
# BEDROCK_DETECT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251015-v1:0
# Seconds between Transcribe job status polls (default: 10)
# TRANSCRIBE_POLL_INTERVAL=10
# Maximum seconds to wait for a Transcribe job before giving up (default: 3600)
# TRANSCRIBE_MAX_WAIT=3600
# Set to "true" to re-transcribe cleaned episodes and detect residual ads.
# Writes a JSON report to EVAL_REPORTS_DIR/{slug}/{episode_id}_eval.json.
# Disabled by default to avoid extra AWS costs on every run.
# EVALUATE_AD_REMOVAL=false
# Directory where ad-removal evaluation reports are written (default: reports)
# EVAL_REPORTS_DIR=reports

# --- Audio Quality ---
# MP3 encoding bitrate in kbps (default: 192)
# MP3_QUALITY=192

# --- Episode Summaries ---
# Set to "true" to generate AI episode summaries via Bedrock (adds one call per new episode)
# GENERATE_SUMMARIES=false

# --- Logging ---
# Directory where rotating log files are written (local runs only; ignored on Lambda).
# LOG_DIR=./logs
# Logging level: DEBUG, INFO, WARNING, ERROR (default: INFO)
# LOG_LEVEL=INFO
# Number of daily log files to retain before the oldest is deleted (default: 30)
# LOG_RETENTION_DAYS=30
