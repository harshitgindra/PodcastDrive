# MediaSync Configuration
# Copy to mediasync.env and source before running:
#   source mediasync.env && .venv/bin/python -m mediasync

# Required
MEDIASYNC_NOTION_TOKEN=ntn_your_token_here
MEDIASYNC_NOTION_DATABASE_ID=your_database_id_here
MEDIASYNC_S3_BUCKET=hg-mediafiles
MEDIASYNC_PROFILES=Harshit,Dishita

# Optional (defaults shown)
# MEDIASYNC_S3_REGION=us-west-2
# MEDIASYNC_S3_PREFIX=MediaSync
# MEDIASYNC_MAX_DURATION_SECS=7200
# MEDIASYNC_OUTPUT_DIR=/tmp/mediasync
# MEDIASYNC_HERALD_ENABLED=true
# MEDIASYNC_HERALD_JOB_ID=mediasync
